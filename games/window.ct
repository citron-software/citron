# Initialisation de la fenêtre et des variables
window 800 600
x = 100
y = 100
vitesse = 6

# Position du trésor
tx = 600
ty = 400

loop
    poll_events

    if key == KEY_ESC
        running = 0
    endif

    if key == KEY_LEFT
        x = x - vitesse
    endif
    if key == KEY_RIGHT
        x = x + vitesse
    endif
    if key == KEY_UP
        y = y - vitesse
    endif
    if key == KEY_DOWN
        y = y + vitesse
    endif

    clear

    # Dessiner le trésor en rouge
    color 220 50 50
    rect tx ty 40 40

    # Dessiner le joueur en jaune
    color 255 220 0
    rect x y 30 30

    present
    delay 16
endloop